# Application Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (Internal Docker Network)
POSTGRES_DB=traceflow_db
POSTGRES_USER=traceflow_user
POSTGRES_PASSWORD=traceflow_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://traceflow_user:traceflow_secure_password@db:5432/traceflow_db

# Generator Configuration
GENERATOR_SEED=20261022
GENERATOR_PROFILE=starter

# Frontend Port (Exposed to Host)
FRONTEND_PORT=8080

# API Configuration (Internal Docker Network)
API_HOST=0.0.0.0
API_PORT=8000

